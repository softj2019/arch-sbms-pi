#=========================================#
#         정류장 번호 : {TERMINAL_ID}
#         정류장 이름 : {정류장명}
#=========================================#

# ======== websocket url =========
DEV_WEBSOCKET_URL=ws://10.0.0.217:8080/websocket
DEV_WEBSOCKET_FALLBACK_URL=ws://192.168.10.108:8080/websocket
PROD_WEBSOCKET_URL=ws://175.45.215.53/websocket
NETWORK_RETRY_INTERVAL_SEC=10
NETWORK_OVERVIEW_INTERVAL_SEC=10
NETWORK_FAILURE_REBOOT_THRESHOLD=10

API_URL=http://localhost:5000

# ======== terminal station (hostname) =========
OFFICE_HOSTNAME=
TERMINAL_ID=

# ======== 환경 타입 =========
# dev  → 개발/테스트 환경: LED 폰트 축소(YSZ=0) 등 개발 편의 적용
# prod → 운영 환경 (기본값, 미설정 시 동일)
ENV_TYPE=prod

# ======== 정류장 타입 =========
# standard   → 일반정류장: GPIO pulse로 모터(UP/DOWN/STOP) 제어 (기본값, 미설정 시 동일)
# smartpole  → 스마트폴: 릴레이보드로 LED/FAN 전원 제어, 모터 없음
#              (STATION_TYPE=smartpole 이면 POWER_CONTROL_MODE=relay 자동 강제)
STATION_TYPE=standard

# ======== 전원 제어 모드 =========
# relay  → Waveshare RPi Relay Board (GPIO, 권장)
# tapo   → TP-Link Tapo 스마트플러그 (네트워크)
# ※ STATION_TYPE=smartpole 이면 이 값은 무시되고 relay로 강제됨
POWER_CONTROL_MODE=relay

# ======== Relay Board (Waveshare RPi Relay Board) =========
# https://www.waveshare.com/wiki/RPi_Relay_Board
# Active LOW: GPIO LOW = 릴레이 ON (장치 전원 공급)
# BCM 핀 번호 기준 (기본값: CH1=26, CH2=20, CH3=21)
RELAY_LED_PIN=26
RELAY_FAN_PIN=20
RELAY_SPARE_PIN=21

# ======== TP Link Account (POWER_CONTROL_MODE=tapo 일 때만 사용) =========
TAPO_USERNAME=
TAPO_PASSWORD=

# ======== IP Addr =========
IP_OPENCV=
IP_ADDRESS_LED=
IP_ADDRESS_FAN=

# ======== RTSP Account =========
USERNAME_OPENCV=
PASSWORD_OPENCV=

# ======== LTE Router Account =========
ORIGINAL_STR=

# ======== manual_override: 수동 명령 후 자동 루프 차단 시간 =========
# /handle/power 로 LED/FAN 수동 제어 시 자동 루프(schedule_device_control, fan_auto_control)가
# 이 시간(초) 동안 덮어쓰지 않습니다. 기본값 300초(5분).
MANUAL_OVERRIDE_DURATION_SEC=300

# ======== LED 전광판 설정 =========
# LED_LINES=2   # 사용 가능한 라인 수 (1 or 2), 기본값 2
# LED_YSZ=1     # 폰트 크기, 기본값 1
